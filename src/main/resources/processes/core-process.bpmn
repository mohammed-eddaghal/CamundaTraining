<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Core" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_Core" name="Core Process" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_Core" name="Start Core">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Get Today&#39;s Date" camunda:delegateExpression="${sendTodayDateDelegate}">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_service_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Core" targetRef="ServiceTask_1" />
    
    <bpmn:exclusiveGateway id="Gateway_1" name="Is June or July?">
      <bpmn:incoming>Flow_service_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_june_july</bpmn:outgoing>
      <bpmn:outgoing>Flow_otherwise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_service_to_gateway" sourceRef="ServiceTask_1" targetRef="Gateway_1" />
    
    <bpmn:sequenceFlow id="Flow_june_july" name="Yes" sourceRef="Gateway_1" targetRef="UserTask_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${currentMonth == 'June' or currentMonth == 'July'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:userTask id="UserTask_1" name="Approve Request" camunda:assignee="admin">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="todayDate" label="Date of Today" type="string">
            <camunda:validation>
              <camunda:constraint name="readonly" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="currentMonth" label="Current Month" type="string">
            <camunda:validation>
              <camunda:constraint name="readonly" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_june_july</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="Flow_otherwise" name="No" sourceRef="Gateway_1" targetRef="UserTask_InvalidMonth">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${currentMonth != 'June' and currentMonth != 'July'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:userTask id="UserTask_InvalidMonth" name="Months are not correct" camunda:assignee="admin">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="currentMonth" label="Current Month" type="string">
            <camunda:validation>
              <camunda:constraint name="readonly" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_otherwise</bpmn:incoming>
      <bpmn:outgoing>Flow_invalid_to_end</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_1" targetRef="EndEvent_1" />
    
    <bpmn:endEvent id="EndEvent_InvalidMonth" name="End (Invalid Month)">
      <bpmn:incoming>Flow_invalid_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_invalid_to_end" sourceRef="UserTask_InvalidMonth" targetRef="EndEvent_InvalidMonth" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Core">
    <bpmndi:BPMNPlane id="BPMNPlane_Core" bpmnElement="Process_Core">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_Core" bpmnElement="StartEvent_Core">
        <dc:Bounds x="179" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="172" y="142" width="51" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_1_di" bpmnElement="ServiceTask_1">
        <dc:Bounds x="270" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="425" y="92" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="412" y="68" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_1_di" bpmnElement="UserTask_1">
        <dc:Bounds x="530" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_InvalidMonth_di" bpmnElement="UserTask_InvalidMonth">
        <dc:Bounds x="530" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="690" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="698" y="142" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_InvalidMonth_di" bpmnElement="EndEvent_InvalidMonth">
        <dc:Bounds x="690" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="681" y="255" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="215" y="117" />
        <di:waypoint x="270" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_service_to_gateway_di" bpmnElement="Flow_service_to_gateway">
        <di:waypoint x="370" y="117" />
        <di:waypoint x="425" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_june_july_di" bpmnElement="Flow_june_july">
        <di:waypoint x="475" y="117" />
        <di:waypoint x="530" y="117" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="494" y="99" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_otherwise_di" bpmnElement="Flow_otherwise">
        <di:waypoint x="450" y="142" />
        <di:waypoint x="450" y="230" />
        <di:waypoint x="530" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="458" y="183" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="630" y="117" />
        <di:waypoint x="690" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_invalid_to_end_di" bpmnElement="Flow_invalid_to_end">
        <di:waypoint x="630" y="230" />
        <di:waypoint x="690" y="230" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
